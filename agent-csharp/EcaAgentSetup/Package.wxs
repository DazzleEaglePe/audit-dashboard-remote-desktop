<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ECA Monitor Agent" 
           Manufacturer="ECA" 
           Version="1.0.0" 
           UpgradeCode="d2d5a3c6-3023-455b-80df-8b2b6ef2713f" 
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="Una versión más nueva de [ProductName] ya está instalada." />
    
    <!-- Launch Conditions: Require ENROLL_TOKEN to proceed with install -->
    <Launch Message="Debe especificar el parámetro ENROLL_TOKEN para la instalación. Ejemplo: msiexec /i EcaAgent.msi ENROLL_TOKEN=eca_enroll_xxx" 
            Condition="Installed OR ENROLL_TOKEN" />

    <Property Id="ENROLL_TOKEN" Secure="yes" />
    <Property Id="API_URL" Value="https://dashboard.ecabot.site/api" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ECADIR" Name="ECA">
        <Directory Id="INSTALLDIR" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentServiceComponents" Directory="INSTALLDIR">
      <Component Guid="*">
        <!-- Register EcaMonitorAgent.exe as KeyPath and install as Windows Service -->
        <File Id="file_EcaMonitorAgent_exe" Source="..\publish\EcaMonitorAgent.exe" KeyPath="yes" />
        
        <ServiceInstall
          Id="ServiceInstaller"
          Type="ownProcess"
          Name="EcaMonitorAgent"
          DisplayName="ECA Monitor Agent"
          Description="ECA Monitor C# Agent - Streaming and system metrics recorder."
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal" />
          
        <ServiceControl
          Id="ServiceControl"
          Name="EcaMonitorAgent"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- Declare JScript Binary -->
    <Binary Id="WriteConfigJS" SourceFile="write-config.js" />

    <!-- Custom Action: Sets CustomActionData properties -->
    <CustomAction 
      Id="SetWriteConfigData" 
      Property="WriteConfig" 
      Value="[CommonAppDataFolder]|[TempFolder]|[API_URL]|[ENROLL_TOKEN]" />

    <CustomAction 
      Id="SetCleanupConfigData" 
      Property="CleanupConfig" 
      Value="[CommonAppDataFolder]" />

    <!-- Custom Actions: Execute JScript functions -->
    <CustomAction 
      Id="WriteConfig" 
      BinaryRef="WriteConfigJS" 
      JScriptCall="WriteConfig" 
      Execute="deferred" 
      Impersonate="no" />

    <CustomAction 
      Id="CleanupConfig" 
      BinaryRef="WriteConfigJS" 
      JScriptCall="CleanupConfig" 
      Execute="deferred" 
      Impersonate="no" />

    <InstallExecuteSequence>
      <!-- Execute WriteConfig only on initial installation -->
      <Custom Action="SetWriteConfigData" Before="WriteConfig" Condition="NOT Installed" />
      <Custom Action="WriteConfig" Before="StartServices" Condition="NOT Installed" />
      
      <!-- Execute CleanupConfig only on uninstallation -->
      <Custom Action="SetCleanupConfigData" Before="CleanupConfig" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="CleanupConfig" After="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="ECA Agent" Level="1">
      <ComponentGroupRef Id="AgentServiceComponents" />
      <ComponentGroupRef Id="AgentPublishComponents" />
    </Feature>
  </Package>
</Wix>
