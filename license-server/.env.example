PORT=4000
DATABASE_URL=postgres://user:pass@localhost:5432/licenses
ADMIN_API_TOKEN=          # Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_PRIVATE_KEY=      # Opcional: Contenido PEM en una sola línea con saltos de línea \n (si no existe private.pem localmente)
ALLOWED_ORIGINS=          # Opcional: Origen del license-admin si se hospeda por separado (ej. http://localhost:3000)
